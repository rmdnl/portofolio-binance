# Binance API Configuration (READ-ONLY KEYS ONLY!)
# Create API keys at https://www.binance.com/en/my/settings/api-management
# Enable "Enable Reading" only - DO NOT enable Spot/Futures Trading or Withdrawals
BINANCE_API_KEY=your_read_only_api_key_here
BINANCE_API_SECRET=your_read_only_api_secret_here
BINANCE_TESTNET=false

# Server Configuration
PORT=8081
NODE_ENV=production

# Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
WS_PING_INTERVAL=30000

# Data Refresh Intervals (ms)
BALANCE_REFRESH_MS=5000
TRADES_REFRESH_MS=10000
PNL_REFRESH_MS=10000
PRICE_REFRESH_MS=2000

# Frontend
FRONTEND_TITLE=PORTFOLIO DASHBOARD
FRONTEND_SUBTITLE=RETROFUTURE EDITION