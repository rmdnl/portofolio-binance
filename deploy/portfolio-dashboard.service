[Unit]
Description=Portfolio Dashboard - Retrofuture Binance Portfolio Tracker
After=network.target
Wants=network.target

[Service]
Type=simple
User=portfolio
Group=portfolio
WorkingDirectory=/opt/portfolio-dashboard
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=portfolio-dashboard

Environment=NODE_ENV=production
Environment=PORT=8081
EnvironmentFile=/opt/portfolio-dashboard/config/.env

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/portfolio-dashboard
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target